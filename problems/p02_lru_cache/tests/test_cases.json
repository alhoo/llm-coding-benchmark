[
  {
    "name": "basic_get_put",
    "description": "Basic get and put operations",
    "capacity": 2,
    "operations": ["put", "put", "get", "put", "get", "put", "get", "get", "get"],
    "args": [[1, 1], [2, 2], [1], [3, 3], [2], [4, 4], [1], [3], [4]],
    "expected": [null, null, 1, null, -1, null, -1, 3, 4]
  },
  {
    "name": "capacity_one",
    "description": "Cache with capacity 1 evicts on every put",
    "capacity": 1,
    "operations": ["put", "get", "put", "get", "get"],
    "args": [[1, 10], [1], [2, 20], [1], [2]],
    "expected": [null, 10, null, -1, 20]
  },
  {
    "name": "overwrite_existing",
    "description": "Putting an existing key updates value and marks as recently used",
    "capacity": 2,
    "operations": ["put", "put", "put", "get", "get"],
    "args": [[1, 1], [2, 2], [1, 10], [1], [2]],
    "expected": [null, null, null, 10, 2]
  },
  {
    "name": "get_updates_recency",
    "description": "get() makes a key the most recently used",
    "capacity": 2,
    "operations": ["put", "put", "get", "put", "get", "get"],
    "args": [[1, 1], [2, 2], [1], [3, 3], [1], [2]],
    "expected": [null, null, 1, null, 1, -1]
  },
  {
    "name": "get_missing_key",
    "description": "Getting a non-existent key returns -1",
    "capacity": 3,
    "operations": ["get", "put", "get"],
    "args": [[99], [1, 100], [99]],
    "expected": [-1, null, -1]
  },
  {
    "name": "large_capacity",
    "description": "No eviction when under capacity",
    "capacity": 5,
    "operations": ["put", "put", "put", "get", "get", "get"],
    "args": [[1, 1], [2, 2], [3, 3], [1], [2], [3]],
    "expected": [null, null, null, 1, 2, 3]
  }
]
